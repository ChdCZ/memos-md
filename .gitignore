/build/
/bin/
/tmp/
/memos
/memos.exe
coverage.out
# Frontend bundles: web/dist from `pnpm build`, and
# server/frontend/dist from `pnpm release`, which go:embed bakes
# into the binary.
dist/

# Local development files
.env
.env.*
!.env.example
.DS_Store
.idea/
.vscode/
/.worktrees/
# Project-scoped pnpm store, created under whichever directory pnpm runs in
# when --config.store-dir is set without an existing store; it contains a
# symlink back to the workspace.
.pnpm-store/

# memos-md: the data directory holds your notes and a local database. Only the
# examples/ copies of the file format are tracked.
/data/memos/
/data/memos_*.db
/data/memos_*.db-shm
/data/memos_*.db-wal
/docker-compose.override.yml
