# Build and local output
/build/
/bin/
/tmp/
/memos
/memos.exe
coverage.out
/.pnpm-store/
/.worktrees/

# Not used by the image build
#
# /web/ IS used: the first stage of ./Dockerfile builds the SPA from it, so the
# frontend sources and lockfile stay in the build context. Upstream's own
# scripts/Dockerfile expects `pnpm release` to have run and still ignores /web/.
/docs/
/.github/
*.md
/.gitignore
/.dockerignore
/.golangci.yaml

# Local data: notes and the SQLite database never belong in an image
/data/
/examples/

# Local metadata and secrets
/.git/
/.env
/.env.*
/.idea/
/.vscode/
/.claude/
**/.DS_Store
